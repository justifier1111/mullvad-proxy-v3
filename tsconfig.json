{
    "compilerOptions": {
        "esModuleInterop": true
      , "jsx": "react-jsx"
      , "lib": [ "ESNext", "DOM", "DOM.Iterable", "WebWorker" ]
      , "module": "esnext"
      , "moduleResolution": "bundler"
      , "noImplicitAny": true
      , "noUnusedParameters": true
      , "removeComments": true
      , "resolveJsonModule": true
      , "sourceMap": true
      , "strict": true
      , "target": "es2020"
    }
}
