{
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "version": "0.2.5",

    "default_locale": "en",
    "manifest_version": 3,

    "developer": {
        "name": "Matt Hensman <m@matt.tf>",
        "url": "https://matt.tf"
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "mullvad@matt.tf",
            "strict_min_version": "109.0"
        }
    },

    "action": {
        "default_icon": {
            "16": "icons/unlocked-16.png",
            "24": "icons/unlocked-24.png",
            "32": "icons/unlocked-32.png"
        },
        "default_popup": "ui/popup/index.html"
    },

    "background": {
        "service_worker": "background.bundle.js"
    },

    "icons": {
        "48": "icons/locked-48.png",
        "96": "icons/locked-96.png"
    },

    "options_ui": {
        "page": "ui/options/index.html"
    },

    "permissions": ["notifications", "storage", "proxy"],

    "host_permissions": ["<all_urls>"],

    "web_accessible_resources": [
        {
            "resources": [""],
            "matches": ["<all_urls>"]
        }
    ]
}
